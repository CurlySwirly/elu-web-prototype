# Supabase Configuration
# Project: mnglufqbmjksllpngwfh
# Get the anon key from: https://supabase.com/dashboard/project/mnglufqbmjksllpngwfh/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://mnglufqbmjksllpngwfh.supabase.co
# Prefer legacy anon JWT from Supabase → Settings → API → Legacy anon key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-legacy-anon-jwt-here

# Backend Mode
# Controls which backend implementation to use
# Options:
#   - 'supabase': Use Supabase as backend (production)
#   - 'mock': Use mock data for frontend development without backend
#   - 'custom': Use your own custom backend (requires implementation)
NEXT_PUBLIC_BACKEND_MODE=supabase

# Demo accounts (password Test1234!):
#   client@test.com      – Client dashboard
#   onboarding@test.com  – Expert with open verification checklist
#   expert@test.com      – Verified active expert

# Server-only secret (legacy service_role JWT) — never NEXT_PUBLIC_
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-jwt-here

# Custom Backend Configuration (only needed if BACKEND_MODE=custom)
# NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api
# NEXT_PUBLIC_API_KEY=your-api-key-here

# Optional: Stripe Configuration (payments + Connect Express for experts)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
#
# Connect Dashboard: set negative balance liability / losses to Stripe so Stripe
# covers connected-account shortfalls (chargebacks/refunds) after Express onboarding.

# Optional: Email Configuration (for notifications)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASSWORD=your-password

# Development
# NODE_ENV=development

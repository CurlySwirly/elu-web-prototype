# Supabase Configuration
# Get these values from your Supabase project settings: https://app.supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Backend Mode
# Controls which backend implementation to use
# Options:
#   - 'supabase': Use Supabase as backend (production)
#   - 'mock': Use mock data for frontend development without backend
#   - 'custom': Use your own custom backend (requires implementation)
NEXT_PUBLIC_BACKEND_MODE=supabase

# Custom Backend Configuration (only needed if BACKEND_MODE=custom)
# NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api
# NEXT_PUBLIC_API_KEY=your-api-key-here

# Optional: Stripe Configuration (for payments)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...

# Optional: Email Configuration (for notifications)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASSWORD=your-password

# Development
# NODE_ENV=development
